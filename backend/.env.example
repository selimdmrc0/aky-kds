# docker-compose.yml ile uyumlu yerel bağlantı
DATABASE_URL="postgresql://akykds:akykds_dev@localhost:5432/akykds?schema=public"

# JWT
JWT_SECRET="degistir-bunu"
JWT_EXPIRES_IN="8h"

# Model servisi (FastAPI)
MODEL_SERVICE_URL="http://localhost:8000"

# Bilgilendirme modülü
PUBLIC_RATE_LIMIT_PER_MIN=10
UPLOAD_MAX_BYTES=2097152
